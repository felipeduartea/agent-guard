{
  "version": 2,
  "session_ids": [],
  "production_identifiers": [],
  "production_paths": [],
  "model": "jev-latest",
  "minimum_allow_probability": 0.95,
  "minimum_confidence": 0.9,
  "api_timeout_seconds": 8,
  "key_file": "~/.codex/guards/jev/typesafe.key",
  "preset": "general-development",
  "packs": [
    "no-auth-changes",
    "protected-paths"
  ],
  "addons": [
    {
      "name": "no-publishing",
      "deny_command_prefixes": [
        [
          "git",
          "push"
        ],
        [
          "npm",
          "publish"
        ]
      ],
      "deny_tools": [
        "mcp__deployment__publish"
      ],
      "instructions": "Do not publish packages or push repository changes."
    }
  ],
  "protected_paths": [
    {
      "path": "/srv/customer-data",
      "access": "read-only"
    },
    {
      "path": "~/.ssh",
      "access": "deny"
    }
  ]
}
